# syntax=docker/dockerfile:1

FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.10.0 --activate
WORKDIR /app

FROM base AS builder

ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_MCP_URL
ARG NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL
ARG NEXT_PUBLIC_BASE_SEPOLIA_CHAIN_ID
ARG NEXT_PUBLIC_BASE_SEPOLIA_AGENT_DELEGATOR_ADDRESS
ARG NEXT_PUBLIC_METAMASK_FLASK_EXTENSION_ID
ARG NEXT_PUBLIC_METAMASK_X402_FACILITATORS
ARG NEXT_PUBLIC_METAMASK_X402_CHAIN_ID
ARG NEXT_PUBLIC_METAMASK_X402_ASSET_ADDRESS

ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_MCP_URL=$NEXT_PUBLIC_MCP_URL
ENV NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=$NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL
ENV NEXT_PUBLIC_BASE_SEPOLIA_CHAIN_ID=$NEXT_PUBLIC_BASE_SEPOLIA_CHAIN_ID
ENV NEXT_PUBLIC_BASE_SEPOLIA_AGENT_DELEGATOR_ADDRESS=$NEXT_PUBLIC_BASE_SEPOLIA_AGENT_DELEGATOR_ADDRESS
ENV NEXT_PUBLIC_METAMASK_FLASK_EXTENSION_ID=$NEXT_PUBLIC_METAMASK_FLASK_EXTENSION_ID
ENV NEXT_PUBLIC_METAMASK_X402_FACILITATORS=$NEXT_PUBLIC_METAMASK_X402_FACILITATORS
ENV NEXT_PUBLIC_METAMASK_X402_CHAIN_ID=$NEXT_PUBLIC_METAMASK_X402_CHAIN_ID
ENV NEXT_PUBLIC_METAMASK_X402_ASSET_ADDRESS=$NEXT_PUBLIC_METAMASK_X402_ASSET_ADDRESS

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages ./packages
COPY hardhat/package.json ./hardhat/package.json
COPY apps/web ./apps/web

RUN pnpm install --frozen-lockfile
RUN pnpm --filter web build

FROM base AS runner
ENV NODE_ENV=production
ENV PORT=3000
WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/web ./apps/web

EXPOSE 3000

CMD ["pnpm", "--filter", "web", "start"]
